<?xml version="1.0" ?>
<sdf version="1.7">
    <world name="simple_world">
        <spherical_coordinates>
            <surface_model>EARTH_WGS84</surface_model>
            <latitude_deg>37.7749</latitude_deg>
            <longitude_deg>-122.4194</longitude_deg>
            <elevation>0.0</elevation>
            <heading_deg>0.0</heading_deg>
        </spherical_coordinates>
        <physics name="default_physics" type="dart">
            <max_step_size>0.01</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>0.5 -0.5 -1</direction>
        </light>
        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane><normal>0 0 1</normal><size>100 100</size></plane>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>0.6</mu>
                                <mu2>0.6</mu2>
                            </ode>
                        </friction>
                    </surface>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane><normal>0 0 1</normal><size>100 100</size></plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
        <model name="vehicle">
            <pose>0.0001 0.0001 0.5 0 0 0</pose>
            <static>false</static>
            <link name="chassis">
                <inertial>
                    <mass>1.0</mass>
                    <inertia>
                        <ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz>
                        <iyy>0.1</iyy><iyz>0</iyz>
                        <izz>0.1</izz>
                    </inertia>
                </inertial>
                <collision name="collision">
                    <geometry>
                        <box><size>1 0.5 0.5</size></box>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>0.6</mu>
                                <mu2>0.6</mu2>
                            </ode>
                        </friction>
                    </surface>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box><size>1 0.5 0.5</size></box>
                    </geometry>
                </visual>
                <sensor name="camera" type="camera">
                    <pose>0 0 0.25 0 0 0</pose>
                    <camera>
                        <horizontal_fov>1.57</horizontal_fov>
                        <image>
                            <width>320</width>
                            <height>240</height>
                        </image>
                        <clip>
                            <near>0.1</near>
                            <far>100</far>
                        </clip>
                    </camera>
                    <plugin name="gz::sim::systems::Sensors" filename="libgz-sim6-sensors-system.so"/>
                    <always_on>true</always_on>
                    <update_rate>30</update_rate>
                    <topic>/camera/image_raw</topic>
                </sensor>
                <sensor name="imu" type="imu">
                    <plugin name="gz::sim::systems::Imu" filename="libgz-sim6-imu-system.so"/>
                    <always_on>true</always_on>
                    <update_rate>100</update_rate>
                    <topic>/imu/data</topic>
                </sensor>
                <sensor name="navsat" type="navsat">
                    <pose>0 0 0 0 0 0</pose>
                    <topic>/gps/fix</topic>
                    <always_on>true</always_on>
                    <update_rate>1.0</update_rate>
                    <plugin name="ignition::gazebo::systems::NavSat" filename="libignition-gazebo6-navsat-system.so">
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.01</stddev>
                        </noise>
                    </plugin>
                </sensor>
            </link>
            <plugin name="gz::sim::systems::VelocityControl" filename="libignition-gazebo6-velocity-control-system.so">
                <topic>/model/vehicle/cmd_vel</topic>
                <initial_linear>1.0 0.0 0.0</initial_linear>
                <initial_angular>0.0 0.0 0.0</initial_angular>
            </plugin>
        </model>
        <model name="stop_sign">
            <pose>10 0 0.5 0 0 0</pose>
            <static>true</static>
            <link name="sign">
                <inertial>
                    <mass>0.5</mass>
                    <inertia>
                        <ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
                        <iyy>0.01</iyy><iyz>0</iyz>
                        <izz>0.01</izz>
                    </inertia>
                </inertial>
                <collision name="sign_collision">
                    <geometry>
                        <box><size>0.5 0.5 0.1</size></box>
                    </geometry>
                </collision>
                <visual name="sign_visual">
                    <geometry>
                        <box><size>0.5 0.5 0.1</size></box>
                    </geometry>
                    <material>
                        <diffuse>1 0 0 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
    </world>
</sdf>